# Healthitude Frontend Environment Configuration
# Optional: Set full backend URL if deploying frontend and backend to different origins
# When left empty, frontend uses relative '/api' with Vite dev proxy (http://localhost:5000)
# Backend API base URL (empty string uses Vite dev proxy to localhost:5000)
VITE_API_BASE_URL=

# Firebase Web App Config (for Google Sign-In / Sign-Up)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
